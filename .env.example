# Template for /opt/aivoice/.env on the server.
# Copy to .env, fill in real values, then: chmod 600 .env
# The real .env is NEVER committed - see .gitignore.

# ---- LiveKit (self-hosted) ----
# Generate with:
#   LK_KEY="API$(openssl rand -hex 8)"
#   LK_SECRET="$(openssl rand -hex 32)"
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Postgres ----
# POSTGRES_PASSWORD generated with: openssl rand -hex 24
POSTGRES_USER=aivoice
POSTGRES_PASSWORD=
POSTGRES_DB=aivoice
DATABASE_URL=postgresql://aivoice:CHANGEME@127.0.0.1:5432/aivoice

# ---- AI providers ----
# Sarvam  -> dashboard.sarvam.ai   (STT saarika + TTS bulbul)
# OpenAI  -> platform.openai.com   (LLM)
SARVAM_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---- tuning (Step 8) ----
# high_vad_sensitivity cuts Sarvam's end-of-speech lag from ~1000ms to ~250ms.
# flush_signal was tested and made no measurable difference.
# The fine-grained VAD params (negative_frames_count etc.) are silently dropped:
# saarika:* has supports_vad_params=False. saaras:v3 would expose them.
SARVAM_HIGH_VAD=1

# Optional overrides - defaults live in the agent_config table in Postgres.
# MIN_ENDPOINTING_DELAY=0.25
# MAX_ENDPOINTING_DELAY=1.5      # 4.0 default froze calls for 4s on short closings
# SARVAM_STT_MODEL=saarika:v2.5
# SARVAM_TTS_VOICE=shubh
# NUM_IDLE_PROCESSES=3
