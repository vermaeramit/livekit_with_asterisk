# Template for /opt/aivoice/.env on the server.
# Copy to .env, fill in real values, then: chmod 600 .env
# The real .env is NEVER committed - see .gitignore.

# ---- LiveKit (self-hosted) ----
# Generate with:
#   LK_KEY="API$(openssl rand -hex 8)"
#   LK_SECRET="$(openssl rand -hex 32)"
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Postgres ----
# POSTGRES_PASSWORD generated with: openssl rand -hex 24
POSTGRES_USER=aivoice
POSTGRES_PASSWORD=
POSTGRES_DB=aivoice
DATABASE_URL=postgresql://aivoice:CHANGEME@127.0.0.1:5432/aivoice

# ---- AI providers ----
# Sarvam  -> dashboard.sarvam.ai   (STT saarika + TTS bulbul)
# OpenAI  -> platform.openai.com   (LLM)
SARVAM_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---- tuning (Step 8) ----
# high_vad_sensitivity cuts Sarvam's end-of-speech lag from ~1000ms to ~250ms.
# flush_signal was tested and made no measurable difference.
# The fine-grained VAD params (negative_frames_count etc.) are silently dropped:
# saarika:* has supports_vad_params=False. saaras:v3 would expose them.
SARVAM_HIGH_VAD=1

# Optional overrides - defaults live in the agent_config table in Postgres.
# Nothing here may shadow a field the console owns. SARVAM_STT_MODEL and
# SARVAM_TTS_VOICE were listed here and did exactly that: they came first
# in the agent's `or` chain, so a value set here beat the console silently
# and a voice changed in the UI never reached a call.
# MIN_ENDPOINTING_DELAY=0.25
# MAX_ENDPOINTING_DELAY=1.5      # 4.0 default froze calls for 4s on short closings
# VAD_MIN_SILENCE=0.35           # silence before Silero calls the turn over.
#                                # Plugin default 0.55, and it shows up as a
#                                # floor: eou was 577 ms on nine turns of one
#                                # call while stt under it moved 297-652.
# PREEMPTIVE_TTS=1               # start the voice before the turn is confirmed.
#                                # The LLM already runs ahead by default; this is
#                                # the other half. Faster, and it pays for every
#                                # discarded generation in TTS characters.
# NUM_IDLE_PROCESSES=3

# How long livekit waits for a job's shutdown callbacks before it KILLS the
# process - SIGUSR1, exit -10, no traceback, nothing logged by us. The plugin
# default is 10, and the last thing our shutdown does is extract the postback,
# which is an LLM round trip. Call 590 ran past it and its result was lost with
# no error anywhere. Raised to 45; costs nothing when healthy, because a normal
# shutdown finishes in about four seconds. Keep it under systemd's 90 s
# TimeoutStopSec or a restart ends in a kill.
# SHUTDOWN_PROCESS_TIMEOUT=45
#
# And its pair. The extraction gives up at this point and writes the postback
# WITHOUT the extracted fields rather than losing the row - the call id,
# outcome, duration and transcript are usually what the client keys on anyway.
# It must stay well below the timeout above: the gap is what pays for building
# the envelope and inserting the row. Raising one without the other only moves
# the cliff.
# POSTBACK_EXTRACT_TIMEOUT=20
