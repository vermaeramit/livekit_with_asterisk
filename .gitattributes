# This repo is edited on Windows and runs on Linux. Two things have to survive
# that trip, and neither does by default.

# Line endings. A shell script checked out with CRLF fails as
# "bad interpreter: /bin/sh^M", and the error names the shell rather than the
# line ending, which is a bad afternoon.
*.sh      text eol=lf
*.sql     text eol=lf
*.conf    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.service text eol=lf
*.timer   text eol=lf
