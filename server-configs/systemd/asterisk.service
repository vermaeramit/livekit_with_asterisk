[Unit]
Description=Asterisk PBX
Documentation=https://docs.asterisk.org
# LiveKit's SIP gateway is the other end of the trunk. Asterisk starting first
# is harmless - the trunk is IP-based with no registration, so it simply works
# once both are up - but ordering keeps the startup logs readable.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=asterisk
Group=asterisk

# -f: stay in the foreground, so systemd tracks the real process rather than a
#     daemonised child it cannot supervise.
# -U/-G are deliberately NOT passed: asterisk.conf already sets runuser/rungroup,
#     and passing both is how you get a process that drops privileges twice and
#     cannot write its own socket.
ExecStart=/usr/sbin/asterisk -f -C /etc/asterisk/asterisk.conf
ExecReload=/usr/sbin/asterisk -rx "core reload"

Restart=always
RestartSec=5

# No AmbientCapabilities / CapabilityBoundingSet here, on purpose. The first
# version of this unit granted CAP_NET_BIND_SERVICE and CAP_SYS_NICE and bounded
# the set to those two - which made Asterisk log "Unable to install
# capabilities" on every start, because bounding the set stops it installing the
# ones it asks for itself. Neither is needed: SIP is on 5060, well above 1024,
# and real-time priority is not enabled in asterisk.conf.

RuntimeDirectory=asterisk
RuntimeDirectoryMode=0755

LimitNOFILE=65535

# A SIGTERM cuts live calls. Give in-progress calls a chance to finish the way
# the agent workers already do - a deploy should not drop a conversation.
KillMode=mixed
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
