[Unit]
Description=AI Voice Agent worker %i
Documentation=https://github.com/vermaeramit/livekit_with_asterisk
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple

# CODE comes from the git checkout, so `git pull && systemctl restart` is the
# whole agent deploy - the same flow as the admin panel.
#
# The VENV deliberately stays in /opt: it is not in git, it is expensive to
# rebuild, and its path has nothing to do with which revision is running.
# /opt/aivoice also keeps .env and gcp/sa.json, which are secrets and must not
# live in a checkout.
WorkingDirectory=/srv/aivoice/agent
EnvironmentFile=/opt/aivoice/.env
# Load is a job count now, not CPU (see load_fnc in voice_agent.py), so these
# two are the real concurrency dials: this box can carry
# MAX_JOBS_PER_WORKER x (number of enabled instances) calls at once. 1.0 means
# a worker stops taking work exactly when it is full - LOAD_THRESHOLD spent
# months being tuned (0.7, 5.0, inf) against a CPU figure the server never
# looked at.
Environment=LOAD_THRESHOLD=1.0
Environment=MAX_JOBS_PER_WORKER=10
# Warm processes, not a capacity limit - a job spawns one on demand if the pool
# is empty, at a ~2.3s cold start. Keep it near the expected concurrent load per
# worker so a burst does not pay that.
Environment=NUM_IDLE_PROCESSES=4
Environment=AGENT_HTTP_PORT=808%i
Environment=LIVEKIT_URL=ws://127.0.0.1:7880

# "start", not "dev": dev mode keeps num_idle_processes at 0, which is why the
# first call after a restart only rang - there was no warm process to take the
# job and livekit-sip will not answer until an agent subscribes to its track.
ExecStart=/opt/aivoice/agent/.venv/bin/python /srv/aivoice/agent/voice_agent.py start

Restart=always
RestartSec=5

# livekit-agents drains in-flight calls on SIGINT. Give it room so a deploy or
# a restart does not cut live conversations mid-sentence.
KillSignal=SIGINT
TimeoutStopSec=180

LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aivoice-agent-%i

[Install]
WantedBy=multi-user.target
