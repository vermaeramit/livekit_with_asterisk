; TEMPLATE. Copy to pjsip.conf on the server and set the real password there.
;
;   cp pjsip.conf.template pjsip.conf   # then edit
;
; pjsip.conf itself is gitignored on purpose. It was tracked with a CHANGEME
; placeholder once, and a `cp -rf server-configs/asterisk/. /opt/aivoice/asterisk/`
; deploy overwrote the live password with it - every endpoint then failed to
; register with 401 and nothing said why.

[global]
type=global
user_agent=AIVoice-Lab

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
local_net=10.130.0.0/16

;=================== Eyebeam test softphone ===================
; rewrite_contact + rtp_symmetric handle the multi-homed workstation:
; the softphone may advertise 172.18.16.1 / 192.168.137.1 in Contact/SDP,
; so Asterisk ignores those and replies to the actual source address.
[1001]
type=endpoint
context=from-internal
disallow=all
allow=ulaw
allow=alaw
auth=1001
aors=1001
direct_media=no
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes

[1001]
type=auth
auth_type=userpass
username=1001
; Set a real secret on the server; never commit one.
password=CHANGEME

[1001]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30

;=================== Trunk -> livekit-sip ===================
; Contact is 10.130.9.243:5080, NOT 127.0.0.1:5080.
; livekit-sip replies from 10.130.9.243; a source/destination mismatch would
; break SIP dialogs. Traffic still stays inside the kernel via lo - no latency cost.
[livekit]
type=endpoint
context=from-livekit
disallow=all
allow=ulaw
allow=alaw
aors=livekit
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[livekit]
type=aor
contact=sip:10.130.9.243:5080

[livekit]
type=identify
endpoint=livekit
match=10.130.9.243

;=================== Trunk <- the production dialler ===================
; Identified by IP, with no auth section: both boxes are ours and on the same
; internal network, so a shared password would be one more secret to rotate and
; leak for no gain.
;
; `identify` is what makes this work at all. Opening the firewall is a SEPARATE
; gate - this address reached Asterisk perfectly well and still got
; "No matching endpoint found", because nothing here claimed it. The two are
; easy to confuse and cost an afternoon each.
;
; The address was read out of that rejection rather than taken on trust:
;
;   asterisk -rx "pjsip set logger on"
;   tail -f /var/log/asterisk/debug.log | grep -iE "INVITE sip:|No matching endpoint"
;
; Its own context, not from-internal. Their calls and the softphone's should be
; distinguishable in the dialplan - so a rule can be applied to one and not the
; other later, without unpicking which is which after the fact.
[dialler]
type=endpoint
context=from-dialler
disallow=all
allow=ulaw
allow=alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[dialler]
type=identify
endpoint=dialler
match=10.130.8.76
