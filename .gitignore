# ---- secrets: never commit ----
.env
.env.*
!.env.example
*.key
*.pem
*.p12
credentials*
secrets*

# Configs that carry a secret: only the template is tracked, so a directory
# copy onto the server cannot overwrite the real one with a placeholder.
# This is not hypothetical - it clobbered the softphone password once.
server-configs/sip/config.yaml
server-configs/asterisk/conf/pjsip.conf

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ---- runtime artifacts ----
*.wav
*.mp3
*.log
recordings/
monitor/
lat-*.wav

# ---- node / frontend ----
node_modules/
dist/
.vite/
*.tsbuildinfo

# ---- editors / os ----
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

