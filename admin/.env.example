# Copy to admin/.env on the server and fill in. chmod 600. Never commit.
#
#   cp admin/.env.example admin/.env && chmod 600 admin/.env
#
# JWT_SECRET must be random and at least 32 bytes. Generate one with:
#   openssl rand -base64 48
# Changing it invalidates every issued access token (refresh tokens survive -
# they are database rows, not signed blobs).

DATABASE_URL=postgresql://aivoice:CHANGEME@postgres:5432/aivoice
JWT_SECRET=CHANGEME

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Comma-separated origins the React app is served from.
# "*" is fine while developing over an SSH tunnel; set the real origin in prod.
CORS_ORIGINS=http://localhost:5173
